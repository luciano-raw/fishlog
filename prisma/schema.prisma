generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id         String   @id // ID que nos dará Clerk
  email      String   @unique
  username   String?
  avatarUrl  String?
  role       String   @default("USER")
  createdAt  DateTime @default(now())
  catches    Catch[]
  spots      Spot[]
  hazards    Hazard[]
  
  // Relaciones de amigos
  friendsAdded  Friendship[] @relation("UserAdded")
  friendsOf     Friendship[] @relation("UserFriendOf")

  pushSubscriptions PushSubscription[]
  shopsCreated Shop[]
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("UserAdded", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("UserFriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model Catch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  species     String
  lureType    String?
  weight      Float?   // en kg
  length      Float?   // en cm
  imageUrl    String?  // URL de la foto en Supabase Storage
  locationLat Float?
  locationLng Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Spot {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  speciesSeen String?
  imageUrl    String?
  locationLat Float
  locationLng Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hazard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  note        String?
  locationLat Float
  locationLng Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String?
  website     String?
  locationLat Float
  locationLng Float
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
